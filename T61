void DrawHLine(const string name, const double price, const color clr)
  {
   if(ObjectFind(name) != -1)
      ObjectDelete(name);
   ObjectCreate(name, OBJ_HLINE, 0, 0, price, 0, 0.0, 0, 0.0);
   ObjectSet(name, OBJPROP_COLOR, clr);
   ObjectSet(name, OBJPROP_STYLE, STYLE_DOT);
   ObjectSet(name, OBJPROP_WIDTH, 1);
  }

void VirtualTrailingProc()
  {
   if(!UseVirtualTrailingStop)
      return;

   int buys = 0, sells = 0;
   int lastBuyTicket = 0, lastSellTicket = 0;

   for(int i = 0; i < OrdersTotal(); i++)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != _Symbol || OrderMagicNumber() != Magic)
         continue;

      int type = OrderType();
      double open = NormalizeDouble(OrderOpenPrice(), Digits);

      if(type == OP_BUY)
        {
         buys++;
         lastBuyTicket = OrderTicket();
         if(StopLoss != 0.0 && Bid <= open - StopLoss * g_pip
            && OrderClose(OrderTicket(), OrderLots(), NormalizeDouble(Bid, Digits), SLIPPAGE, clrNONE))
            continue;
         if(TakeProfit != 0.0 && Bid >= TakeProfit * g_pip + open
            && OrderClose(OrderTicket(), OrderLots(), NormalizeDouble(Bid, Digits), SLIPPAGE, clrNONE))
            continue;
         if(VirtualTrailingStop > 0)
           {
            double trail = NormalizeDouble(Bid - VirtualTrailingStop * g_pip, Digits);
            if(trail >= VirtualTrailingStart * g_pip + open)
               if(g_vSlBuy == 0.0 || g_vSlBuy + VirtualTrailingStep * g_pip < trail)
                  g_vSlBuy = trail;
           }
        }

      if(type == OP_SELL)
        {
         sells++;
         if(StopLoss != 0.0 && Ask >= StopLoss * g_pip + open
            && OrderClose(OrderTicket(), OrderLots(), NormalizeDouble(Ask, Digits), SLIPPAGE, clrNONE))
            continue;
         if(TakeProfit != 0.0 && Ask <= open - TakeProfit * g_pip
            && OrderClose(OrderTicket(), OrderLots(), NormalizeDouble(Ask, Digits), SLIPPAGE, clrNONE))
            continue;
         lastSellTicket = OrderTicket();
         if(VirtualTrailingStop > 0)
           {
            double trail = NormalizeDouble(VirtualTrailingStop * g_pip + Ask, Digits);
            if(trail <= open - VirtualTrailingStart * g_pip)
               if(g_vSlSell == 0.0 || g_vSlSell - VirtualTrailingStep * g_pip > trail)
                  g_vSlSell = trail;
           }
        }
     }

   if(buys > 0)
     {
      if(buys <= 1 && g_vSlBuy != 0.0)
        {
         DrawHLine("SL Buy", g_vSlBuy, clrBlue);
         double px = NormalizeDouble(Bid, Digits);
         if(Bid <= g_vSlBuy
            && OrderSelect(lastBuyTicket, SELECT_BY_TICKET, MODE_TRADES)
            && OrderProfit() > 0.0
            && !OrderClose(lastBuyTicket, OrderLots(), px, SLIPPAGE, clrRed))
            Comment("");
        }
     }
   else
     {
      g_vSlBuy = 0.0;
      ObjectDelete("SL Buy");
     }

   if(sells > 0)
     {
      if(sells > 1 || g_vSlSell == 0.0)
         return;
      DrawHLine("SL Sell", g_vSlSell, clrRed);
      if(Ask >= g_vSlSell
         && OrderSelect(lastSellTicket, SELECT_BY_TICKET, MODE_TRADES)
         && OrderProfit() > 0.0
         && !OrderClose(lastSellTicket, OrderLots(), NormalizeDouble(Ask, Digits), SLIPPAGE, clrRed))
         Comment("");
     }
   else
     {
      g_vSlSell = 0.0;
      ObjectDelete("SL Sell");
     }
  }

//+------------------------------------------------------------------+
//| Stop-order placement (was inlined twice in OnTick)               |
//+------------------------------------------------------------------+
void PlaceStopOrder(const int cmd, const int slot = 0)
  {
   double lots = CalcLots();
   double stopDist = MarketInfo(_Symbol, MODE_STOPLEVEL) * Point;
   double price;

   if(cmd == OP_BUYSTOP)
     {
      // cada slot se separa PendingStepPips hacia arriba del pivote
      price = NormalizeDouble(g_upperHi + (Distance + slot * PENDING_STEP_PIPS) * g_pip, Digits); // BUYSTOP
      if(price - MarketInfo(_Symbol, MODE_ASK) <= stopDist)
         price = MarketInfo(_Symbol, MODE_ASK) + stopDist;
     }
   else
     {
      price = NormalizeDouble(g_lowerLo - (Distance + slot * PENDING_STEP_PIPS) * g_pip, Digits); // SELLSTOP
      if(MarketInfo(_Symbol, MODE_BID) - price <= stopDist)
         price = MarketInfo(_Symbol, MODE_BID) - stopDist;
     }

   WaitTradeAllowed(50);
   WaitTradeContext(50);
   int ticket = OrderSend(_Symbol, cmd, lots, price, SLIPPAGE, 0.0, 0.0, Name_EA, Magic, 0, clrNONE);
   if(ticket > 0)
     {
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
         ApplySlTp(cmd == OP_BUYSTOP);
     }
   else
     {
      int err = GetLastError();
      ResetLastError();
      Print(_Symbol, " Unable to open order! Error: ", err);
     }
  }

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int ResolveGmtOffset()
  {
   if(!(AutoGMT && !IsTesting()))
      return GMTOffset;

   char postData[], result[];
   string resultHeaders = "";
   RefreshRates();
   datetime serverNow = TimeCurrent();
   if(WebRequest("GET", GMT_URL, "", 10, postData, result, resultHeaders) != -1)
     {
      string body = CharArrayToString(result, 0, -1, 0);
      int offset = (int)MathRound((double)((long)serverNow - (long)StrToTime(body)) / 3600.0);
      ArrayFree(result);
      ArrayFree(postData);
      return offset;
     }
   int err = GetLastError();
   ResetLastError();
   Print("Error: ", err);
   MessageBox("Add the address '" + GMT_URL + "' in the list of allowed URLs on tab 'Expert Advisors'", "Error", 64);
   ExpertRemove();
   return 0;
  }

int OnInit()
  {
   g_gmtOffset = ResolveGmtOffset();

   g_stopLevelPx = MarketInfo(_Symbol, MODE_STOPLEVEL) * Point;
   g_pip = (Digits == 5 || Digits == 3) ? Point * 10.0 : Point;
   g_trailPx = TrailingStop * g_pip;
   g_slPx = StopLoss * g_pip;
   g_tpPx = TakeProfit * g_pip;
   g_beDistPx = BreakEven * g_pip;
   g_beLockPx = BEpoint * g_pip;
   g_blocked = true;

g_lastBuyStopSignal  = 0.0;
g_lastSellStopSignal = 0.0;

   // --- VALIDACIÓN DE SERIE ELIMINADA ---
   // Establecemos g_blocked en false para que el EA opere libremente sin clave
   g_blocked = false; 

   g_openOrders = CountMarketOrders();
   return INIT_SUCCEEDED;
  }

//+------------------------------------------------------------------+
//| Expert tick                                                      |
//+------------------------------------------------------------------+
void OnTick()
  {
   if(IsTradingTime())
      UpdateSpreadStats();

   DrawInfoPanel();
   FixNewOrderSlTp();

   TrailingStopProc();
   VirtualTrailingProc();
   if(UseBreakEven)
      BreakEvenProc();

   if(!IsTradingTime())
   {
   if(Endhour)
   {
      while(!DeleteAllPending())
      {
      }
   }
   return;
   }

   //--- once per new chart bar
   datetime barTime = Time[0];
   if(g_lastBarTime == barTime)
      return;

   UpdateZigZagLevels();

// remove stale stop orders (versión compatible con múltiples pendientes)
for(int i = OrdersTotal() - 1; i >= 0; i--)
  {
   if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
      continue;
   if(OrderSymbol() != _Symbol || OrderMagicNumber() != Magic)
      continue;
   if(OrderType() != OP_BUYSTOP && OrderType() != OP_SELLSTOP)
      continue;

   if(OrderType() == OP_BUYSTOP && g_upperHi > Ask && g_upperHi == g_firstHi
      && OrderOpenPrice() < g_upperHi)          // por debajo del pivote → inválida
      {
       if(!OrderDelete(OrderTicket(), clrNONE))
          Print("Error deleting BUYSTOP order.");
      }

   if(OrderType() == OP_SELLSTOP && g_lowerLo < Bid && g_lowerLo == g_firstLo
      && OrderOpenPrice() > g_lowerLo)          // por encima del pivote → inválida
      {
       if(!OrderDelete(OrderTicket(), clrNONE))
          Print("Error deleting SELLSTOP order.");
      }
  }

//--- 1) contar pendientes por lado y ver si hay posición de mercado
int countBuyStop = 0, countSellStop = 0;
bool hasBuy = false, hasSell = false;

for(int i = 0; i < OrdersTotal(); i++)
  {
   if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
      continue;
   if(Magic >= 0 && OrderMagicNumber() != Magic)
      continue;
   if(OrderSymbol() != _Symbol)
      continue;
   switch(OrderType())
     {
      case OP_BUYSTOP:  countBuyStop++;  break;
      case OP_SELLSTOP: countSellStop++; break;
      case OP_BUY:      hasBuy = true;   break;
      case OP_SELL:     hasSell = true;  break;
     }
  }


bool limitBuyOk      = (MaxPendingPerSide <= 99 || countBuyStop  < MaxPendingPerSide);
bool limitSellOk     = (MaxPendingPerSide <= 99 || countSellStop < MaxPendingPerSide);

//--- 2) BUYSTOP: solo si este pivote (g_upperHi) aún no ha sido usado
if(limitBuyOk && !g_spreadTooHigh
   && g_upperHi > 0.0 && Bid < g_upperHi && g_upperHi >= g_firstHi
   && MathAbs(g_upperHi - g_lastBuyStopSignal) > _Point * 0.5)   // pivote nuevo
  {
   PlaceStopOrder(OP_BUYSTOP, countBuyStop);
   g_lastBuyStopSignal = g_upperHi;
  }

//--- 3) SELLSTOP: solo si este pivote (g_lowerLo) aún no ha sido usado
if(limitSellOk && !g_spreadTooHigh
   && g_lowerLo > 0.0 && Ask > g_lowerLo && g_lowerLo <= g_firstLo
   && MathAbs(g_lowerLo - g_lastSellStopSignal) > _Point * 0.5)  // pivote nuevo
  {
   PlaceStopOrder(OP_SELLSTOP, countSellStop);
   g_lastSellStopSignal = g_lowerLo;
  }

g_lastBarTime = barTime;
  }

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   for(int i = ObjectsTotal(EMPTY) - 1; i >= 0; i--)
     {
      string name = ObjectName(0, i, -1, -1);
      if(StringFind(name, "Info", 0) < 0)
         continue;
      ObjectDelete(0, name);
      i++;   // kept from original
     }
   ObjectsDeleteAll(0, 0, OBJ_TREND);
   ObjectsDeleteAll(0, 0, OBJ_TEXT);
  }

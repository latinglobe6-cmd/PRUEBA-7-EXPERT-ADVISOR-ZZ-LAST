//+------------------------------------------------------------------+
//| Small helpers                                                    |
//+------------------------------------------------------------------+
void WaitTradeAllowed(const int ms)
  {
   while(!IsTradeAllowed())
      Sleep(ms);
  }

void WaitTradeContext(const int ms)
  {
   while(IsTradeContextBusy())
      Sleep(ms);
  }

// buy + sell orders of this symbol/magic (original CountOrders(10))
int CountMarketOrders()
  {
   int n = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;
      if(OrderType() == OP_BUY || OrderType() == OP_SELL)
         n++;
     }
   return n;
  }

// pending orders of this symbol/magic; false on first failure (original DeletePending(10))
bool DeleteAllPending()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         return false;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;
      WaitTradeContext(100);
      int t = OrderType();
      if(t == OP_BUYSTOP || t == OP_SELLSTOP || t == OP_BUYLIMIT || t == OP_SELLLIMIT)
         if(!OrderDelete(OrderTicket(), clrNONE))
            return false;
     }
   return true;
  }

// SL/TP for the currently selected order, from the open price
void ApplySlTp(const bool isBuy)
  {
   double open = OrderOpenPrice();
   double sl = NormalizeDouble(isBuy ? open - g_slPx : open + g_slPx, Digits);
   double tp = NormalizeDouble(isBuy ? open + g_tpPx : open - g_tpPx, Digits);
   WaitTradeAllowed(50);
   WaitTradeContext(50);
   if(!OrderModify(OrderTicket(), OrderOpenPrice(), sl, tp, OrderExpiration(), clrNONE))
     {
      int err = GetLastError();
      ResetLastError();
      Print(OrderSymbol(), " Unable to set SL/TP! Error: ", err);
     }
  }

//+------------------------------------------------------------------+
//| Lot size (was inlined twice in OnTick)                           |
//| NOTE: exactly as decompiled - only LotVar == 1 computes a lot;   |
//| any other LotVar gives 0.0, which is then raised to MODE_MINLOT. |
//+------------------------------------------------------------------+

double CalcLots()
{
   double minLot = MarketInfo(_Symbol, MODE_MINLOT);
   double maxLot = MarketInfo(_Symbol, MODE_MAXLOT);
   double step   = MarketInfo(_Symbol, MODE_LOTSTEP);

   int lotDigits = 0;
   if(step == 0.001) lotDigits = 3;
   if(step == 0.01)  lotDigits = 2;
   if(step == 0.1)   lotDigits = 1;
   if(step == 1.0)   lotDigits = 0;

   double lots = minLot;

   if(LotVar == 2)          // original: según margen libre
      lots = AccountFreeMargin() / LOT_DIVISOR * minLot;
   else if(LotVar == 1)     // variable: % de riesgo sobre el balance, usando el StopLoss
   {
      double tickValue = MarketInfo(_Symbol, MODE_TICKVALUE);
      double tickSize  = MarketInfo(_Symbol, MODE_TICKSIZE);
      if(tickValue > 0 && tickSize > 0 && g_slPx > 0)
      {
         double riskMoney = AccountBalance() * Risk / 100.0;
         double lossPerLot = g_slPx / tickSize * tickValue;
         lots = riskMoney / lossPerLot;
      }
   }
   else if(LotVar == 0)     // lote fijo
      lots = FixLot;

   lots = MathFloor(lots / step) * step;   // ajusta al paso del broker
   lots = NormalizeDouble(lots, lotDigits);

   if(lots < minLot) lots = minLot;
   if(lots > maxLot) lots = maxLot;
   return lots;
}

//+------------------------------------------------------------------+
//| ZigZag levels (was func_3f6)                                     |
//+------------------------------------------------------------------+
void AccumulatePivot(const double v, double &hi, double &lo)
  {
   if(v <= 0.0)
      return;
   if(lo == 0.0)
     {
      lo = v;
      hi = v;
      return;
     }
   if(v > hi)
      hi = v;
   if(v < lo)
      lo = v;
  }

void UpdateZigZagLevels()
  {
   double hi = 0.0, lo = 0.0;
   int shift = 0;
   do
     {
      AccumulatePivot(iCustom(_Symbol, 0, "ZigZag", ZZ_DEPTH, ZZ_DEVIATION, ZZ_BACKSTEP, 0, shift), hi, lo);
      shift++;
     }
   while(lo == hi);
   g_firstHi = NormalizeDouble(hi, 5);
   g_firstLo = NormalizeDouble(lo, 5);

   shift = ZZ_SECOND_START;
   hi = 0.0;
   lo = 0.0;
   int tries = 300;
   do
     {
      AccumulatePivot(iCustom(_Symbol, 0, "ZigZag", ZZ_DEPTH, ZZ_DEVIATION, ZZ_BACKSTEP, 0, shift), hi, lo);
      shift++;
      tries++;
      if(lo != hi)
         break;
     }
   while(tries < 600);
   if(tries == 600)
      return;
   g_upperHi = NormalizeDouble(hi, 5);
   g_lowerLo = NormalizeDouble(lo, 5);
  }

//+------------------------------------------------------------------+
//| Trading time window (was func_3f7)                               |
//+------------------------------------------------------------------+
bool IsTradingTime()
  {
   int enabled;
   string startStr, stopStr;
   switch(DayOfWeek())
     {
      case 1: enabled = Monday;    startStr = StartTimeMon; stopStr = StopTimeMon; break;
      case 2: enabled = Tuesday;   startStr = StartTimeTue; stopStr = StopTimeTue; break;
      case 3: enabled = Wednesday; startStr = StartTimeWed; stopStr = StopTimeWed; break;
      case 4: enabled = Thursday;  startStr = StartTimeThu; stopStr = StopTimeThu; break;
      case 5: enabled = Friday;    startStr = StartTimeFri; stopStr = StopTimeFri; break;
      case 6: enabled = Saturday;  startStr = StartTimeSat; stopStr = StopTimeSat; break;
      default: enabled = Sunday;   startStr = StartTimeSun; stopStr = StopTimeSun; break;
     }
   if(enabled != 1)
      return false;

   string day = StringConcatenate(Year(), ".", Month(), ".", Day(), " ");
   long shiftSec = (long)g_gmtOffset * 3600;
   long from = (long)StringToTime(day + startStr) + shiftSec;
   long to = (long)StringToTime(day + stopStr) + shiftSec;
   return (TimeCurrent() > from && TimeCurrent() < to);
  }

//+------------------------------------------------------------------+
//| Average spread per IntervalMin bar + delayed pending delete      |
//+------------------------------------------------------------------+
void UpdateSpreadStats()
  {
   datetime barTime = iTime(_Symbol, IntervalMin, 0);
   if(barTime > g_spreadBarTime)
     {
      g_spreadTicks = 0;
      g_spreadSum = 0.0;
      g_spreadBarTime = barTime;
     }
   g_spreadTicks++;
   g_spreadSum += (Ask - Bid) / g_pip;
   g_avgSpread = g_spreadSum / g_spreadTicks;

   if(FilterSpread && g_avgSpread > MaxAverageSpread)
     {
      g_spreadText = DoubleToStr(g_avgSpread, 2) + " Max Average Spread too high!";
      g_spreadTooHigh = true;
     }
   else
     {
      g_spreadText = DoubleToStr(g_avgSpread, 2);
      g_spreadTooHigh = false;
     }

   if(g_deleteAt > 0)
     {
      if(g_spreadTooHigh && TimeCurrent() >= g_deleteAt)
        {
         for(int i = OrdersTotal() - 1; i >= 0; i--)
           {
            if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
               continue;
            if(OrderSymbol() != _Symbol)
               continue;
            if(OrderMagicNumber() != Magic)
               continue;
            if(OrderType() <= OP_SELL)
               continue;
            OrderDelete(OrderTicket(), clrAliceBlue);
            i++;   // kept from original: re-visits the same index after a delete
           }
         g_deleteAt = 0;
        }
      else
         if(TimeCurrent() >= g_deleteAt)
            g_deleteAt = 0;
     }
   if(g_spreadTooHigh && g_deleteAt == 0)
      g_deleteAt = TimeCurrent() + SpreadTooHighDeleteOrderMin * 60;
  }

